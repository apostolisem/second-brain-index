# Paths are relative to this file. A '#' after a space starts a comment.

# Semicolon-separated PARA roots
PARA_ROOTS=/path/to/para-root-1;/path/to/para-root-2

# Optional: semicolon-separated roots scanned as direct subfolders (Others section)
OTHER_FOLDERS=/path/to/other-root-1;/path/to/other-root-2

# Obsidian vault root
OBSIDIAN_VAULT=/path/to/obsidian-vault

# Obsidian vault name (as shown in Obsidian)
OBSIDIAN_VAULT_NAME=Obsidian

# Optional: reveal opened file in the Obsidian file explorer (requires Advanced URI plugin)
OBSIDIAN_REVEAL_ACTIVE=false
OBSIDIAN_REVEAL_COMMAND=file-explorer:reveal-active-file

# Optional: OneNote topic list + base URL for opening OneNote
ONENOTE_ENABLED=false
ONENOTE_BASE_URL=https://www.onenote.com/notebooks
# Optional: where the list is (default: OneNote_topics_list.json next to this file)
# ONENOTE_TOPICS_LIST=OneNote_topics_list.json

# Optional: Outlook topic list + base URL for opening Outlook
OUTLOOK_ENABLED=false
OUTLOOK_BASE_URL=https://outlook.office.com/mail
# OUTLOOK_TOPICS_LIST=Outlook_topics_list.json

# Optional: PLM topic list + base URL for opening PLM
PLM_ENABLED=false
PLM_BASE_URL=https://plm.example.com
# PLM_TOPICS_LIST=PLM_topics_list.json

# Optional: location for manual links database
DB_PATH=second_brain_index.db

# Optional: watch PARA roots and JSON sources and refresh automatically
AUTO_REFRESH=true

# Optional: write Topics_export.json next to the lists and into each sub-hub
TOPICS_EXPORT=true
